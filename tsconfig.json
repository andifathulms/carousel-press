{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "carousel-core": [
        "./packages/carousel-core/src/index.ts"
      ],
      "carousel-core/src/*": [
        "./packages/carousel-core/src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "packages/carousel-core/src",
    "packages/carousel-core/scripts",
    "vite.config.ts"
  ]
}
