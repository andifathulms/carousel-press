{
  "name": "carousel-press",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "review": "REVIEW=1 vite build --outDir dist-review && tsx scripts/review.ts",
    "check:cedict": "tsx scripts/check-cedict.ts",
    "fonts:sync": "tsx packages/carousel-core/scripts/sync-fonts.ts",
    "fonts:check": "tsx packages/carousel-core/scripts/sync-fonts.ts --check",
    "core:build": "vite build --config packages/carousel-core/vite.config.ts && vite build --config packages/carousel-core/vite.browser.config.ts && tsc -p packages/carousel-core/tsconfig.build.json",
    "core:smoke": "tsx packages/carousel-core/scripts/smoke.ts",
    "core:release": "bash packages/carousel-core/scripts/release.sh"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/gentium-book-plus": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
